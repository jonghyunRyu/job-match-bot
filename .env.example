# Google Gemini API 키 (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=your_api_key_here

# 사용할 모델 (기본값: gemini-flash-latest = 항상 최신 flash를 가리키는 별칭)
GEMINI_MODEL=gemini-flash-latest

# 임베딩 모델 (RAG용, 기본값: gemini-embedding-001)
GEMINI_EMBED_MODEL=gemini-embedding-001

# RAG 검색 시 매칭에 넣을 프로필 청크 수
RAG_TOP_K=4

# 일시적 서버 오류(503/429 등) 시 최대 재시도 횟수
LLM_MAX_RETRIES=4
